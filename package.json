{
  "name": "efimero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generador de codigos QR estatico, con estilos, logo y verificacion de escaneabilidad. 100% en el navegador.",
  "license": "MIT",
  "author": "Efímero contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/BRYANMN0305/efimero.git"
  },
  "homepage": "https://efimero.vercel.app",
  "bugs": {
    "url": "https://github.com/BRYANMN0305/efimero/issues"
  },
  "keywords": [
    "qr",
    "qr-code",
    "generador",
    "offline",
    "privacy",
    "no-cookies",
    "open-source",
    "static-site"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:prebuild && vite build && npm run check:postbuild",
    "build:offline": "npm run build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "check:sources": "node scripts/check-sources.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-huerfanas": "node scripts/check-i18n-huerfanas.mjs",
    "check:exports-huerfanos": "node scripts/check-exports-huerfanos.mjs",
    "check:no-network": "node scripts/check-no-network.mjs",
    "check:prebuild": "npm run check:sources && npm run check:vendor && npm run check:i18n && npm run check:i18n-huerfanas && npm run check:exports-huerfanos && npm run typecheck",
    "check:postbuild": "npm run check:no-network",
    "check:integridad": "npm run check:sources && npm run check:vendor && npm run check:i18n && npm run check:i18n-huerfanas && npm run check:exports-huerfanos && npm run check:no-network",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build",
    "deps:audit": "npm audit --audit-level=high",
    "deps:signatures": "npm audit signatures"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsqr": "1.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
